import java.util.ArrayList;
import java.util.List;

/** Sistema de archivos modelado como árbol general. */
public class SistemaArchivos {

    static class Nodo {
        String valor;
        List<Nodo> hijos = new ArrayList<>();

        Nodo(String valor) { this.valor = valor; }

        Nodo agregar(String valorHijo) {
            Nodo hijo = new Nodo(valorHijo);
            hijos.add(hijo);
            return hijo;
        }

        int contar() {
            int total = 1;
            for (Nodo h : hijos) total += h.contar();
            return total;
        }

        int altura() {
            int max = 0;
            for (Nodo h : hijos) max = Math.max(max, h.altura());
            return max + 1;
        }

        void imprimir() {
            System.out.println(valor);
            for (int i = 0; i < hijos.size(); i++)
                hijos.get(i).imprimir("", i == hijos.size() - 1);
        }

        private void imprimir(String prefijo, boolean ultimo) {
            System.out.println(prefijo + (ultimo ? "└── " : "├── ") + valor);
            for (int i = 0; i < hijos.size(); i++)
                hijos.get(i).imprimir(prefijo + (ultimo ? "    " : "│   "), i == hijos.size() - 1);
        }
    }

    static Nodo crear() {
        Nodo raiz = new Nodo("C:/");
        Nodo usuarios = raiz.agregar("Usuarios");
        Nodo tomas = usuarios.agregar("Tomas");
        Nodo docs = tomas.agregar("Documentos");
        docs.agregar("tarea.docx");
        docs.agregar("notas.txt");
        tomas.agregar("Imagenes").agregar("foto.png");
        Nodo programas = raiz.agregar("Programas");
        programas.agregar("Java").agregar("jdk-21");
        programas.agregar("Draw.io");
        raiz.agregar("Windows").agregar("System32");
        return raiz;
    }

    public static void main(String[] args) {
        Nodo raiz = crear();
        raiz.imprimir();
        System.out.println("Nodos: " + raiz.contar() + " | Altura: " + raiz.altura());
    }
}
